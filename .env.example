# Copien este archivo como ".env" y ajusten los valores para su organizacion.
# El archivo ".env" NO se sube a GitHub (ver .gitignore).

POSTGRES_DB=proyecto_db
POSTGRES_USER=proyecto_user
POSTGRES_PASSWORD=proyecto_pass

# Mercado Pago
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# URL publica HTTPS del frontend de Guinda
# Ejemplo: tunel HTTPS de Vite
FRONT_URL=

# URL publica HTTPS del backend de Guinda
# Ejemplo: tunel HTTPS de ngrok o cloudflared
BACKEND_PUBLIC_URL=

# URL del frontend para generar enlaces de recuperación de contraseña.
# FRONTEND_URL es independiente de FRONT_URL, utilizada por Mercado Pago.
# En producción, configurar una URL pública HTTPS.
# Recuperación de contraseñas
FRONTEND_URL=http://localhost:5173
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL="Guinda Perfumería <no-responder@guinda.local>"

# ------------------------------------------------------------
# Modo servidor (compose.servidor.yaml). En desarrollo no se usan.
# ------------------------------------------------------------
# Clave propia, larga y aleatoria (mínimo 50 caracteres). Generarla con:
#   docker compose exec web python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Direcciones aceptadas. ".trycloudflare.com" acepta cualquier túnel rápido.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.trycloudflare.com
CSRF_TRUSTED_ORIGINS=https://*.trycloudflare.com
# Carpeta del front ya compilado (npm run build en el repo del front)
FRONT_DIST=../Sistema_Guinda_DesarrolloWeb/dist
# Con túnel queda en 1. Para probar sin túnel (http://localhost) poner 0.
SECURE_SSL_REDIRECT=1
