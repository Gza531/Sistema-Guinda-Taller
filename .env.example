# Copien este archivo como ".env" y ajusten los valores para su organizacion.
# El archivo ".env" NO se sube a GitHub (ver .gitignore).

POSTGRES_DB=proyecto_db
POSTGRES_USER=proyecto_user
POSTGRES_PASSWORD=proyecto_pass

# Mercado Pago
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_COSTO_ENVIO=0

# URL publica HTTPS del frontend de Guinda
FRONT_URL=https://tienda.example

# URL publica HTTPS del backend de Guinda
BACKEND_PUBLIC_URL=https://api.tienda.example
